# Production configuration.
#
# Baked into the binary by envied at code-generation time — NOT bundled as an
# asset and NOT read at runtime. Select it with `make env_production`.
ENVIRONMENT=PROD

# Network
BASE_URL=https://dog.ceo/api
CONNECT_TIMEOUT_MS=10000
RECEIVE_TIMEOUT_MS=30000
SEND_TIMEOUT_MS=30000
ENABLE_NETWORK_LOG=false

# Sent as an Authorization header when non-empty. Obfuscated at rest in the
# binary. Empty here because the dog API needs no credential; a real deployment
# injects it from the CI secret store before running `make env_production`.
API_KEY=

# Android signing certificate SHA-256 fingerprints allowed by the runtime
# signature check, comma-separated. `keytool` prints FA:BA:...; strip the
# colons. Empty disables the comparison — fill this in before shipping, or the
# signature check silently passes for a resigned APK.
VALID_ANDROID_SIGNATURES=

# Transport security.
#
# ENABLE_ANTI_PROXY forces the client past the system proxy, so Charles,
# Proxyman, and Burp see nothing. It also installs the adapter that performs
# SPKI pinning, so SPKI hashes without it are a startup error rather than a
# silent no-op.
#
# SPKI_SHA256_HASHES pins the server's public key, checked during the TLS
# handshake already happening. Comma-separated; include your backup key or a
# rotation will require an app release. Read one with:
#   openssl s_client -connect host:443 </dev/null 2>/dev/null \
#     | openssl x509 -pubkey -noout \
#     | openssl pkey -pubin -outform der | openssl dgst -sha256
#
# CERTIFICATE_SHA256_FINGERPRINTS pins the whole certificate. Stricter, but it
# breaks on every renewal AND costs a separate TLS connection per request.
# Leave empty unless the threat model demands it on top of SPKI.
ENABLE_ANTI_PROXY=true
SPKI_SHA256_HASHES=
CERTIFICATE_SHA256_FINGERPRINTS=
