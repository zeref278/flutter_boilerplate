# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Xcode's Swift Package Manager resolution state. Regenerated on every build
# from the Flutter tool's own package graph, so committing it only produces
# churn. ios/Podfile.lock is committed, because that one pins what ships.
**/xcshareddata/swiftpm/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Release signing. key.properties names a keystore and carries its passwords;
# key.properties.example is committed in its place. Never commit a keystore.
/android/key.properties
*.jks
*.keystore

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# fvm
.fvm/versions
.fvm/flutter_sdk

# Generated code — regenerate with `make setup`.
# One consistent policy: nothing generated is committed.
*.g.dart
*.freezed.dart
*.mocks.dart
/lib/generated/

# Design docs written during development, kept out of version control.
/docs/superpowers/
