# Development configuration.
#
# Baked into the binary by envied at code-generation time — NOT bundled as an
# asset and NOT read at runtime. Select it with `make env_dev`.
ENVIRONMENT=DEV

# Network
BASE_URL=https://dog.ceo/api
CONNECT_TIMEOUT_MS=10000
RECEIVE_TIMEOUT_MS=30000
SEND_TIMEOUT_MS=30000
ENABLE_NETWORK_LOG=true

# Sent as an Authorization header when non-empty. Obfuscated at rest in the
# binary. Empty here because the dog API needs no credential.
API_KEY=

# Android signing certificate SHA-256 fingerprints allowed by the runtime
# signature check, comma-separated. `keytool` prints FA:BA:...; strip the
# colons. Empty disables the comparison, which is correct for debug builds.
VALID_ANDROID_SIGNATURES=

# Transport security. All three are off here: a debugging proxy is a tool
# during development, and a pinned certificate would break every local mock.
ENABLE_ANTI_PROXY=false
SPKI_SHA256_HASHES=
CERTIFICATE_SHA256_FINGERPRINTS=
